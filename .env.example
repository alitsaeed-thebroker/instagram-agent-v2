# OpenAI API credentials for knowledge extraction.
# Add real values in a local .env file; never commit that file.
OPENAI_API_KEY=your_api_key_here
# Optional: defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Meta / Instagram publishing. Keep real values only in .env.
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=

# Cloudflare R2 S3-compatible media hosting. Keep real values only in .env.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=instagram-agent-media
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-EXAMPLE.r2.dev
